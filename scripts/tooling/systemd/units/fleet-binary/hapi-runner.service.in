[Unit]
Description=HAPI runner (@HOST_LABEL@)
After=network-online.target @HUB_UNIT@
Wants=network-online.target

[Service]
Type=simple
KillMode=process
User=@HAPI_USER@
Group=@HAPI_GROUP@
Environment=HAPI_HOME=@HAPI_HOME@
Environment=PATH=@HAPI_PATH@
Environment=HAPI_API_URL=http://127.0.0.1:@HAPI_PORT@
Environment=HAPI_RUNNER_SUPERVISED=1
WorkingDirectory=@HAPI_HOME@
ExecStart=@HAPI_BIN@ runner start-sync @WORKSPACE_ROOT_ARGS@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
