# Quiet Meta refresh — every 45 minutes, 24/7 (odd-hours safe).
#
# Keeps chip statusCheckedAt fresh so the UI never hits the 2h stale mute.
# Does NOT ping peers (that is morning hapi-meta-daily.timer only).
#
# OnUnitActiveSec (not OnCalendar daytime window): operator keeps odd hours;
# overnight gaps were making chips go ?.
#
# Fork-local. Install: sudo bash scripts/tooling/install-hapi-meta-daily-timer.sh

[Unit]
Description=HAPI Meta PR watcher timer (quiet chip/inbox refresh, 24/7)
Documentation=file:///home/heavygee/coding/hapi/docs/operator/AGENTS.md

[Timer]
# Catch up soon after boot / enable, then every 45m forever
OnBootSec=3min
OnUnitActiveSec=45min
AccuracySec=1min
Unit=hapi-meta-daily-refresh.service

[Install]
WantedBy=timers.target
