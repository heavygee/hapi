# Heal: AGENT_NOTIFY_SUMMARY footers with prose glued after the JSON.
#
# heavygee/hapi#322. Operator saw Happy render a closing message as the raw
# JSON footer with prose welded onto it (`...}Dark-mode capture finished`).
# matchNotifySummaryLine bailed on `if (!trimmedEnd.endsWith('}')) return null`,
# so nothing was extracted and nothing was stripped.
#
# Why a heal and not a thin layer: the composed shared/src/messages.ts is a
# SOUP variant (collapseRepeats / findNotifyTokenStart, Cursor SUMMARY->SUMARY
# tolerance) that exists on no single layer branch — the live content is
# identical to merge-resolution commit ab9ce7ce3 on the integration line. The
# equivalent fix for the upstream variant is a real branch,
# fix/notify-summary-trailing-prose (8233bbc69), shaped for an upstream PR.
# Retire this heal once that lands and the soup absorbs it.
#
# Tests ride along in the patch so --verify covers them: 5 of the 7 fail
# without this change; the other 2 are over-matching guards that must pass
# either way.
diff --git a/shared/src/messages.test.ts b/shared/src/messages.test.ts
index e0fa59393..8ee90da69 100644
--- a/shared/src/messages.test.ts
+++ b/shared/src/messages.test.ts
@@ -517,3 +517,54 @@ describe('hasConversationMessageContent', () => {
         expect(hasConversationMessageContent(content)).toBe(false)
     })
 })
+
+describe('AGENT_NOTIFY_SUMMARY footers with prose glued after the JSON', () => {
+    // Operator-reported 2026-11-09: Happy rendered the raw JSON with prose
+    // welded on, because the trimmed line did not end with `}` so the parser
+    // bailed before scanning. heavygee/hapi#322.
+    const glued = 'AGENT_NOTIFY_SUMMARY {"version":1,"status":"needs_decision","summary":"Do you want these cuts?"}Dark-mode capture finished cleanly.'
+
+    test('extracts the summary despite trailing prose', () => {
+        const got = extractNotifySummary(glued)
+        expect(got).not.toBeNull()
+        expect(got?.status).toBe('needs_decision')
+        expect(got?.summary).toBe('Do you want these cuts?')
+    })
+
+    test('strips the footer and KEEPS the trailing prose visible', () => {
+        const visible = stripNotifySummaryFooter(glued)
+        expect(visible).toBe('Dark-mode capture finished cleanly.')
+        expect(visible).not.toContain('AGENT_NOTIFY_SUMMARY')
+    })
+
+    test('keeps prose glued on BOTH sides', () => {
+        const both = 'Done.AGENT_NOTIFY_SUMMARY {"status":"done","summary":"s"}And more.'
+        expect(extractNotifySummary(both)?.status).toBe('done')
+        expect(stripNotifySummaryFooter(both)).toBe('Done. And more.')
+    })
+
+    test('is not confused by braces inside a summary string', () => {
+        const braces = 'AGENT_NOTIFY_SUMMARY {"status":"done","summary":"fixed the {foo} handler"}trailing'
+        expect(extractNotifySummary(braces)?.summary).toBe('fixed the {foo} handler')
+        expect(stripNotifySummaryFooter(braces)).toBe('trailing')
+    })
+
+    test('keeps the Cursor dup-drop tolerance working with trailing prose', () => {
+        // collapseRepeats recovers SUMMARY -> SUMARY; it must still apply now
+        // that the closing brace is found by scanning.
+        const dropped = 'AGENT_NOTIFY_SUMARY {"status":"done","summary":"ok"}tail'
+        expect(extractNotifySummary(dropped)?.summary).toBe('ok')
+    })
+
+    test('still rejects a prose mention rather than eating the sentence', () => {
+        const mention = 'See the AGENT_NOTIFY_SUMMARY {"status":"done"} docs for details.'
+        expect(extractNotifySummary(mention)).toBeNull()
+        expect(stripNotifySummaryFooter(mention)).toBe(mention)
+    })
+
+    test('leaves a truncated object unmatched', () => {
+        const broken = 'AGENT_NOTIFY_SUMMARY {"status":"done","summary":"unterminated'
+        expect(extractNotifySummary(broken)).toBeNull()
+        expect(stripNotifySummaryFooter(broken)).toBe(broken)
+    })
+})
