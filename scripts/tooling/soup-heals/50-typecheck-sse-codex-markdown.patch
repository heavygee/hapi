From 4f231ad0312412024c05d431d2fc98fe2466c269 Mon Sep 17 00:00:00 2001
From: Debian <heavygee@oos-linux.in.lockhouse>
Date: Tue, 14 Jul 2026 14:38:17 +0000
Subject: [PATCH] fix(soup): post-rematerialize typecheck heal (markdown cast)

Thin overseer rematerialize dropped late fat soup-fix layers; restore the
verify-critical pieces as tip commits (same intent as former layers/heals).

NOTE (2026-07-19, meta): the rpcGateway.ts hunk (listCodexSessionsForMachine
/ RpcListCodexSessionsResponse) was removed because the codex/claude import
cluster is temporarily PARKED off the soup for the 0.23.1 base bump — see
config/driver-manifest.yaml. Its RPC surface + consumers left with the cluster,
so the heal is no longer verify-critical. Restore when the cluster is re-added.
Companion heal 51-codex-rpc-list-export.patch is parked (.parked) for the same
reason. The useSSE.ts toSummaryMetadata-removal hunk was also dropped: upstream
0.23.1 reworked SSE summary metadata handling, so that hunk no longer applies
cleanly and is not needed on the new base (verified by typecheck).

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 web/src/components/MarkdownRenderer.tsx |  4 ++--
 web/src/hooks/useSSE.ts                 | 22 ----------------------
 2 files changed, 2 insertions(+), 24 deletions(-)

diff --git a/web/src/components/MarkdownRenderer.tsx b/web/src/components/MarkdownRenderer.tsx
index e66122cd6..111307fef 100644
--- a/web/src/components/MarkdownRenderer.tsx
+++ b/web/src/components/MarkdownRenderer.tsx
@@ -71,8 +71,8 @@ function StandaloneMarkdownContent(props: MarkdownRendererProps) {
 
     const components = useMemo<Components>(() => ({
         ...(componentsRest as Components),
-        pre: StandalonePre,
-        code: StandaloneCode,
+        pre: StandalonePre as NonNullable<Components['pre']>,
+        code: StandaloneCode as NonNullable<Components['code']>,
     }), [componentsRest])
 
     return (
