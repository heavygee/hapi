# 93-router-overseer-nav-button.patch
#
# feat/overseer-admin-console (#103) adds a dedicated /overseer console and put an
# Overseer nav button in the pre-restructure inline toolbar. rerere drops that
# inline toolbar (see heal 89), so the shell would lose the Overseer entry point.
#
# Heal 89 folds the onboarding tour into the single <SessionList headerActions>
# toolbar (browse/settings/new + FueDot). This heal runs AFTER 89 and does ONE
# thing: insert a plain Overseer nav button (-> /overseer) between the browse and
# settings buttons. Kept separate from 89 so it stays a pure insertion (no context
# modification) — combining it into 89 made the 3-way heal apply conflict when the
# tour-dot hunk and the button insertion overlapped. OverseerIcon is defined in
# router.tsx (added by the admin-console layer).
diff --git a/web/src/router.tsx b/web/src/router.tsx
index cb0b02e6..0a8c76e8 100644
--- a/web/src/router.tsx
+++ b/web/src/router.tsx
@@ -819,6 +819,14 @@ function SessionsPage() {
                                         <FueDot pulsing ariaLabel={t('fue.newFeatureDot')} />
                                     ) : null}
                                 </button>
+                                <button
+                                    type="button"
+                                    onClick={() => navigate({ to: '/overseer' })}
+                                    className="p-1.5 rounded-full text-[var(--app-hint)] hover:text-[var(--app-fg)] hover:bg-[var(--app-subtle-bg)] transition-colors"
+                                    title="Overseer"
+                                >
+                                    <OverseerIcon className="h-5 w-5" />
+                                </button>
                                 <button
                                     ref={tourSettingsRef}
                                     type="button"
