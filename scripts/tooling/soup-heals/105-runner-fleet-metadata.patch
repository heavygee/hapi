+export function inferMachineArch(platform: string | null | undefined): string | undefined {
+    if (!platform) {
+        return undefined
+    }
+    switch (platform) {
+        case 'linux':
+        case 'win32':
+        case 'darwin':
+            return 'x64'
+        default:
+            return undefined
+    }
+}
