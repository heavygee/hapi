# 90-versioned-todos-teamstate-consumers.patch (meta-soup 5bcf291c, 2026-07-31)
#
# feat/sse-patch-extend-session-state (#884) moved SessionPatch todos/teamState to
# the versioned { version, value } shape. The base advance merged took the versioned
# SCHEMA but dropped the layer's CONSUMER updates in several files (split merge),
# leaving old unversioned readers/writers against the new schema -> typecheck + test
# fails. This re-syncs the consumers to the layer's canonical form:
#   - shared/src/schemas.ts: add Session.todosUpdatedAt / teamStateUpdatedAt (read by
#     sessionSummary, written by sessionCache).
#   - web/src/hooks/useSSE.ts: unwrap patch.todos.value / patch.teamState.value and
#     track .version (mirrors hub applySessionPatch).
#   - hub .../sessionHandlers.ts: emit todos/teamState wrapped as { version, value }.
#   - the three tests: assert the versioned shape (values taken verbatim from the layer).
diff --git a/hub/src/socket/handlers/cli/sessionHandlers.test.ts b/hub/src/socket/handlers/cli/sessionHandlers.test.ts
index d37830b6..eecaebc6 100644
--- a/hub/src/socket/handlers/cli/sessionHandlers.test.ts
+++ b/hub/src/socket/handlers/cli/sessionHandlers.test.ts
@@ -113,10 +113,13 @@ describe('cli session handlers', () => {
         expect(sessionUpdated).toBeDefined()
         if (!sessionUpdated || sessionUpdated.type !== 'session-updated') return
         expect(sessionUpdated.data).toMatchObject({
-            todos: [
-                { content: 'pending thing', status: 'pending' },
-                { content: 'done thing', status: 'completed' }
-            ]
+            todos: {
+                version: expect.any(Number),
+                value: [
+                    { content: 'pending thing', status: 'pending' },
+                    { content: 'done thing', status: 'completed' }
+                ]
+            }
         })
         expect(typeof (sessionUpdated.data as { updatedAt?: number }).updatedAt).toBe('number')
         expect((sessionUpdated.data as { updatedAt?: number }).updatedAt).toBeGreaterThan(0)
